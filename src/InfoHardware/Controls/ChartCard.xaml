<UserControl x:Class="InfoHardware.Controls.ChartCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:InfoHardware.Controls"
             x:Name="Root">
    <Border Style="{StaticResource Card}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding Title, ElementName=Root}" Style="{StaticResource CardTitle}"/>

            <WrapPanel Grid.Row="1" Margin="0,10,0,8">
                <StackPanel Orientation="Horizontal" Margin="0,0,22,0">
                    <Ellipse Width="9" Height="9" Fill="{Binding Primary.Brush, ElementName=Root}" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="{Binding Primary.Series.Color, ElementName=Root}" BlurRadius="10" ShadowDepth="0"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="{Binding Primary.Text, ElementName=Root}" Style="{StaticResource MidNum}" FontSize="24"/>
                    <TextBlock Text="{Binding Primary.Unit, ElementName=Root}" Style="{StaticResource Dim}" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                    <TextBlock Text="{Binding Primary.Name, ElementName=Root}" Style="{StaticResource Mute}" VerticalAlignment="Bottom" Margin="8,0,0,4"/>
                </StackPanel>
                <StackPanel x:Name="SecondaryPanel" Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" Fill="{Binding Secondary.Brush, ElementName=Root}" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="{Binding Secondary.Series.Color, ElementName=Root}" BlurRadius="10" ShadowDepth="0"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="{Binding Secondary.Text, ElementName=Root}" Style="{StaticResource MidNum}" FontSize="24"/>
                    <TextBlock Text="{Binding Secondary.Unit, ElementName=Root}" Style="{StaticResource Dim}" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                    <TextBlock Text="{Binding Secondary.Name, ElementName=Root}" Style="{StaticResource Mute}" VerticalAlignment="Bottom" Margin="8,0,0,4"/>
                </StackPanel>
            </WrapPanel>

            <Border Grid.Row="2" CornerRadius="8" Background="#0B0616" BorderBrush="#1F1236" BorderThickness="1" Padding="2">
                <c:LiveChart x:Name="Chart" Maximum="{Binding Maximum, ElementName=Root}"/>
            </Border>

            <TextBlock Grid.Row="3" Margin="0,8,0,0" Style="{StaticResource Mute}" Text="{Binding Primary.StatsText, ElementName=Root}"/>
        </Grid>
    </Border>
</UserControl>
