<UserControl x:Class="InfoHardware.Views.SensorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,0,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="8,4,8,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox Style="{StaticResource SearchBox}" Width="260" Tag="Filtrar sensores (ex.: temperatura, fan)"
                         Text="{Binding SensorFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                <Button Style="{StaticResource GhostButton}" Click="Reset_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/>
                        <TextBlock Text="Zerar mín/máx"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Sensores" Style="{StaticResource PageTitle}" FontSize="26"/>
                <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,0">
                    <Run Text="Leitura em tempo real de todos os sensores disponíveis · "/><Run Text="{Binding SensorCount, Mode=OneWay}"/><Run Text=" sensores"/>
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <TextBlock Grid.Row="1" Text="Detectando sensores… (pode levar alguns segundos na primeira vez)" Style="{StaticResource Dim}" Margin="8"
                   Visibility="{Binding IsSensorsLoading, Converter={StaticResource BoolToVis}}"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding SensorGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="0" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <DockPanel Margin="18,14,18,10">
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mute}" VerticalAlignment="Center">
                                        <Run Text="{Binding Count, Mode=OneWay}"/><Run Text=" sensores"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" Foreground="{StaticResource NeonPurpleBrush}" Margin="0,0,12,0" Effect="{StaticResource GlowPurple}"/>
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Grid Margin="18,0,18,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="SENSOR" Style="{StaticResource Mute}" FontWeight="Bold" FontSize="10.5"/>
                                    <TextBlock Grid.Column="1" Text="TIPO" Style="{StaticResource Mute}" FontWeight="Bold" FontSize="10.5"/>
                                    <TextBlock Grid.Column="2" Text="ATUAL" Style="{StaticResource Mute}" FontWeight="Bold" FontSize="10.5" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="MÍNIMO" Style="{StaticResource Mute}" FontWeight="Bold" FontSize="10.5" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="4" Text="MÁXIMO" Style="{StaticResource Mute}" FontWeight="Bold" FontSize="10.5" HorizontalAlignment="Right"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Rows}" Margin="0,0,0,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Row" Padding="18,6" Background="Transparent" BorderBrush="#1A1030" BorderThickness="0,1,0,0"
                                                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="120"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="7" Height="7" Fill="{Binding TypeBrush}" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding TypeName}" FontSize="12" Foreground="{StaticResource TextDimBrush}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding Value}" FontFamily="{StaticResource NumFont}" FontSize="14" HorizontalAlignment="Right" Foreground="White"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Min}" FontFamily="{StaticResource NumFont}" FontSize="13" HorizontalAlignment="Right" Foreground="{StaticResource CyanBrush}"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding Max}" FontFamily="{StaticResource NumFont}" FontSize="13" HorizontalAlignment="Right" Foreground="{StaticResource PinkBrush}"/>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="#1A0F31"/>
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
