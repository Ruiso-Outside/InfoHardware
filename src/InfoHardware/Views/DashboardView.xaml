<UserControl x:Class="InfoHardware.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:InfoHardware.Controls">
    <UserControl.Resources>
        <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource MidNum}">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource Mute}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,0,24,24">
        <StackPanel>
            <!-- Cabeçalho -->
            <StackPanel Margin="8,4,8,14">
                <TextBlock Text="Visão geral" Style="{StaticResource PageTitle}" FontSize="26"/>
                <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,14">
                    <Run Text="{Binding Summary.Os, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Summary.Board, Mode=OneWay}"/>
                </TextBlock>
                <WrapPanel>
                    <Border Style="{StaticResource Chip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE950;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource PurpleBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Summary.Cpu}" FontSize="12.5"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Chip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource CyanBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Summary.Gpu}" FontSize="12.5"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Chip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEEA0;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource GreenBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Summary.Ram}" FontSize="12.5"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>

            <!-- Aviso do driver PawnIO -->
            <Border Margin="8,0,8,8" Padding="16,12" CornerRadius="12" Background="#1F0F22" BorderBrush="#7A2A5A" BorderThickness="1"
                    Visibility="{Binding ShowPawnIoWarning, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource NeonButton}" Content="Instalar driver PawnIO" Click="InstallPawnIo_Click" Padding="14,7"/>
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource OrangeBrush}" Margin="0,0,12,0"/>
                    <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}" FontSize="12.5" Margin="0,0,12,0"
                               Text="O driver PawnIO não está instalado. Sem ele, a temperatura/consumo da CPU, ventoinhas e tensões da placa-mãe podem não aparecer."/>
                </DockPanel>
            </Border>

            <!-- Aviso de tela cheia exclusiva -->
            <Border Margin="8,0,8,8" Padding="16,12" CornerRadius="12" Background="#1F0F22" BorderBrush="#7A2A5A" BorderThickness="1"
                    Visibility="{Binding HasExclusiveWarning, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="OK" Padding="14,6" Click="DismissExclusive_Click"/>
                    <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" Foreground="{StaticResource OrangeBrush}" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding ExclusiveFullscreenWarning}" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{StaticResource TextDimBrush}" FontSize="12.5" Margin="0,0,12,0"/>
                </DockPanel>
            </Border>

            <!-- Medidores -->
            <UniformGrid Columns="4">
                <!-- CPU -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="PROCESSADOR" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{Binding Live.CpuName}" Style="{StaticResource Dim}" Margin="0,4,0,0"/>
                        <Grid Width="170" Height="170" Margin="0,12,0,8">
                            <c:ArcGauge Value="{Binding Live.CpuLoad.GaugeValue}" Maximum="100" ColorFrom="#7C3AED" ColorTo="#FF3CAC"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Live.CpuLoad.Text}" Style="{StaticResource BigNum}" FontSize="42" Effect="{StaticResource GlowPurple}"/>
                                    <TextBlock Text="%" Style="{StaticResource Dim}" FontSize="16" VerticalAlignment="Bottom" Margin="2,0,0,9"/>
                                </StackPanel>
                                <TextBlock Text="USO" Style="{StaticResource Mute}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <UniformGrid Columns="3">
                            <StackPanel><TextBlock Text="{Binding Live.CpuTemp.TextWithUnit}" Style="{StaticResource StatValue}" Foreground="{StaticResource PinkBrush}"/><TextBlock Text="Temperatura" Style="{StaticResource StatLabel}"/></StackPanel>
                            <StackPanel><TextBlock Text="{Binding Live.CpuClock.Text}" Style="{StaticResource StatValue}"/><TextBlock Text="Clock" Style="{StaticResource StatLabel}"/></StackPanel>
                            <StackPanel><TextBlock Text="{Binding Live.CpuPower.TextWithUnit}" Style="{StaticResource StatValue}"/><TextBlock Text="Consumo" Style="{StaticResource StatLabel}"/></StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- GPU -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="PLACA DE VÍDEO" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{Binding Live.GpuName}" Style="{StaticResource Dim}" Margin="0,4,0,0"/>
                        <Grid Width="170" Height="170" Margin="0,12,0,8">
                            <c:ArcGauge Value="{Binding Live.GpuLoad.GaugeValue}" Maximum="100" ColorFrom="#22D3EE" ColorTo="#A855F7"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Live.GpuLoad.Text}" Style="{StaticResource BigNum}" FontSize="42" Effect="{StaticResource GlowCyan}"/>
                                    <TextBlock Text="%" Style="{StaticResource Dim}" FontSize="16" VerticalAlignment="Bottom" Margin="2,0,0,9"/>
                                </StackPanel>
                                <TextBlock Text="USO" Style="{StaticResource Mute}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <UniformGrid Columns="3">
                            <StackPanel><TextBlock Text="{Binding Live.GpuTemp.TextWithUnit}" Style="{StaticResource StatValue}" Foreground="{StaticResource OrangeBrush}"/><TextBlock Text="Temperatura" Style="{StaticResource StatLabel}"/></StackPanel>
                            <StackPanel><TextBlock Text="{Binding Live.GpuClock.Text}" Style="{StaticResource StatValue}"/><TextBlock Text="Clock" Style="{StaticResource StatLabel}"/></StackPanel>
                            <StackPanel><TextBlock Text="{Binding Live.GpuPower.TextWithUnit}" Style="{StaticResource StatValue}"/><TextBlock Text="Consumo" Style="{StaticResource StatLabel}"/></StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- RAM -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="MEMÓRIA RAM" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{Binding Summary.Ram}" Style="{StaticResource Dim}" Margin="0,4,0,0"/>
                        <Grid Width="170" Height="170" Margin="0,12,0,8">
                            <c:ArcGauge Value="{Binding Live.RamLoad.GaugeValue}" Maximum="100" ColorFrom="#39FF88" ColorTo="#22D3EE"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Live.RamLoad.Text}" Style="{StaticResource BigNum}" FontSize="42">
                                        <TextBlock.Effect><DropShadowEffect Color="#39FF88" BlurRadius="16" ShadowDepth="0" Opacity="0.7"/></TextBlock.Effect>
                                    </TextBlock>
                                    <TextBlock Text="%" Style="{StaticResource Dim}" FontSize="16" VerticalAlignment="Bottom" Margin="2,0,0,9"/>
                                </StackPanel>
                                <TextBlock Text="EM USO" Style="{StaticResource Mute}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <UniformGrid Columns="2">
                            <StackPanel><TextBlock Text="{Binding Live.RamUsed.TextWithUnit}" Style="{StaticResource StatValue}" Foreground="{StaticResource GreenBrush}"/><TextBlock Text="Usada" Style="{StaticResource StatLabel}"/></StackPanel>
                            <StackPanel><TextBlock Text="{Binding Live.RamTotalText}" Style="{StaticResource StatValue}"/><TextBlock Text="Total" Style="{StaticResource StatLabel}"/></StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- VRAM -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="MEMÓRIA DE VÍDEO" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{Binding Live.GpuName}" Style="{StaticResource Dim}" Margin="0,4,0,0"/>
                        <Grid Width="170" Height="170" Margin="0,12,0,8">
                            <c:ArcGauge Value="{Binding Live.VramLoad.GaugeValue}" Maximum="100" ColorFrom="#FF3CAC" ColorTo="#FFB020"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Live.VramLoad.Text}" Style="{StaticResource BigNum}" FontSize="42" Effect="{StaticResource GlowPink}"/>
                                    <TextBlock Text="%" Style="{StaticResource Dim}" FontSize="16" VerticalAlignment="Bottom" Margin="2,0,0,9"/>
                                </StackPanel>
                                <TextBlock Text="EM USO" Style="{StaticResource Mute}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <UniformGrid Columns="3">
                            <StackPanel><TextBlock Text="{Binding Live.VramUsed.TextWithUnit}" Style="{StaticResource StatValue}" Foreground="{StaticResource PinkBrush}"/><TextBlock Text="Usada" Style="{StaticResource StatLabel}"/></StackPanel>
                            <StackPanel><TextBlock Text="{Binding Live.VramTotalText}" Style="{StaticResource StatValue}"/><TextBlock Text="Total" Style="{StaticResource StatLabel}"/></StackPanel>
                            <StackPanel><TextBlock Text="{Binding Live.GpuMemClock.Text}" Style="{StaticResource StatValue}"/><TextBlock Text="Clock" Style="{StaticResource StatLabel}"/></StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- FPS + uso -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Height="270">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" CornerRadius="6" Padding="8,2" Background="#132A2E"
                                    Visibility="{Binding Live.FpsIsForeground, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="EM FOCO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"/>
                            </Border>
                            <TextBlock Text="FPS AO VIVO" Style="{StaticResource CardTitle}"/>
                        </DockPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding Live.Fps.Text}" Style="{StaticResource BigNum}" FontSize="58" Foreground="White" Effect="{StaticResource GlowCyan}"/>
                            <TextBlock Text="FPS" Style="{StaticResource Dim}" FontSize="15" VerticalAlignment="Bottom" Margin="6,0,0,12"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2">
                            <TextBlock Text="{Binding Live.FpsProcess}" Style="{StaticResource Dim}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                                <TextBlock Style="{StaticResource Mute}" FontSize="12.5"><Run Text="Frametime "/><Run Text="{Binding Live.FrameTime.TextWithUnit, Mode=OneWay}" Foreground="{StaticResource PinkBrush}"/></TextBlock>
                                <TextBlock Style="{StaticResource Mute}" FontSize="12.5" Margin="18,0,0,0"><Run Text="1% low "/><Run Text="{Binding Live.Fps1Low.Text, Mode=OneWay}" Foreground="{StaticResource NeonPurpleBrush}"/></TextBlock>
                            </StackPanel>
                            <TextBlock Text="{Binding FpsStatus}" Style="{StaticResource Mute}" TextWrapping="Wrap"
                                       Visibility="{Binding FpsInactive, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <c:LiveChart Grid.Row="3" x:Name="FpsChart" ShowScale="True"/>
                    </Grid>
                </Border>
                <c:ChartCard Grid.Column="1" Height="286" Title="USO DE CPU E GPU" Primary="{Binding Live.CpuLoad}" Secondary="{Binding Live.GpuLoad}" Maximum="100"/>
            </Grid>

            <!-- Temperaturas, núcleos, disco/rede -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <c:ChartCard Height="300" Title="TEMPERATURAS" Primary="{Binding Live.CpuTemp}" Secondary="{Binding Live.GpuTemp}" Maximum="100"/>

                <Border Grid.Column="1" Style="{StaticResource Card}" Height="284">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}">
                            <Run Text="NÚCLEOS / THREADS · "/><Run Text="{Binding Live.Cores.Count, Mode=OneWay}"/>
                        </TextBlock>
                        <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Live.Cores}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3,12,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="38"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Mute}" FontFamily="{StaticResource NumFont}"/>
                                            <ProgressBar Grid.Column="1" Style="{StaticResource NeonBar}" Value="{Binding Value, Mode=OneWay}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Text}" FontFamily="{StaticResource NumFont}" FontSize="11.5" HorizontalAlignment="Right" Foreground="{StaticResource TextDimBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Height="284">
                    <StackPanel>
                        <TextBlock Text="DISCO E REDE" Style="{StaticResource CardTitle}"/>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,0,18">
                                <TextBlock Text="{Binding Live.DiskRead.Text}" Style="{StaticResource MidNum}" FontSize="18" Foreground="{StaticResource CyanBrush}"/>
                                <TextBlock Text="&#x2193; Leitura do disco" Style="{StaticResource Mute}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Live.DiskWrite.Text}" Style="{StaticResource MidNum}" FontSize="18" Foreground="{StaticResource PinkBrush}"/>
                                <TextBlock Text="&#x2191; Escrita do disco" Style="{StaticResource Mute}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,0,0,18">
                                <TextBlock Text="{Binding Live.NetDown.Text}" Style="{StaticResource MidNum}" FontSize="18" Foreground="{StaticResource GreenBrush}"/>
                                <TextBlock Text="&#x2193; Download" Style="{StaticResource Mute}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock Text="{Binding Live.NetUp.Text}" Style="{StaticResource MidNum}" FontSize="18" Foreground="{StaticResource NeonPurpleBrush}"/>
                                <TextBlock Text="&#x2191; Upload" Style="{StaticResource Mute}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2">
                                <TextBlock Text="{Binding Live.DiskTemp.TextWithUnit}" Style="{StaticResource MidNum}" FontSize="18"/>
                                <TextBlock Text="Temp. do disco" Style="{StaticResource Mute}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1">
                                <TextBlock Text="{Binding Live.GpuFan.TextWithUnit}" Style="{StaticResource MidNum}" FontSize="18"/>
                                <TextBlock Text="Ventoinha da GPU" Style="{StaticResource Mute}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
