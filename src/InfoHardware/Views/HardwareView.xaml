<UserControl x:Class="InfoHardware.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,0,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="8,4,8,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Click="Copy_Click" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/>
                        <TextBlock Text="Copiar"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource NeonButton}" Click="Export_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/>
                        <TextBlock Text="Exportar relatório"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Informações do hardware" Style="{StaticResource PageTitle}" FontSize="26"/>
                <TextBlock Text="Tudo o que está instalado nesta máquina, peça por peça." Style="{StaticResource Dim}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <TextBlock Grid.Row="1" Text="Coletando informações do sistema…" Style="{StaticResource Dim}" Margin="8"
                   Visibility="{Binding IsInfoLoading, Converter={StaticResource BoolToVis}}"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="8">
                <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}"
                         Style="{StaticResource SectionList}" ItemContainerStyle="{StaticResource SectionItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="17" Foreground="{StaticResource NeonPurpleBrush}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Mute}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,22">
                    <StackPanel DataContext="{Binding SelectedSection}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Width="46" Height="46" CornerRadius="12" Background="{StaticResource NeonGradient}" Margin="0,0,14,0" Effect="{StaticResource GlowPurple}">
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="20" Foreground="White" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Dim}"/>
                            </StackPanel>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,18,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Visibility="{Binding HasHeader, Converter={StaticResource BoolToVis}}">
                                            <Rectangle Width="3" Height="16" Fill="{StaticResource NeonGradient}" RadiusX="1.5" RadiusY="1.5" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding Header}" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource NeonPurpleBrush}"/>
                                        </StackPanel>
                                        <Border CornerRadius="10" Background="#0D0719" BorderBrush="#22143D" BorderThickness="1">
                                            <ItemsControl ItemsSource="{Binding Items}" AlternationCount="2">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="Row" Padding="14,9" Background="Transparent">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="230"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextDimBrush}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                                <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                                         Foreground="{StaticResource TextBrush}" FontSize="13" TextWrapping="Wrap" Padding="0"
                                                                         SelectionBrush="{StaticResource PurpleBrush}" CaretBrush="Transparent"/>
                                                            </Grid>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource TemplatedParent}}" Value="1">
                                                                <Setter TargetName="Row" Property="Background" Value="#120A22"/>
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
