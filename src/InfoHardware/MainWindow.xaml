<Window x:Class="InfoHardware.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="InfoHardware" Width="1360" Height="860" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg0Brush}"
        Icon="/Assets/app.ico" FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" BorderThickness="1" BorderBrush="#2E1A52">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Brilhos decorativos do fundo -->
            <Canvas Grid.Column="1" IsHitTestVisible="False" ClipToBounds="True">
                <Ellipse Canvas.Left="-200" Canvas.Top="-260" Width="720" Height="560" Opacity="0.55">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#3A1470" Offset="0"/>
                            <GradientStop Color="#003A1470" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Canvas>
            <Ellipse Grid.Column="1" Width="760" Height="560" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-320,-300" Opacity="0.4" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#5A0F4A" Offset="0"/>
                        <GradientStop Color="#005A0F4A" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- ===== Barra lateral ===== -->
            <Border Background="{StaticResource Bg1Brush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Rectangle Grid.RowSpan="3" Width="1" HorizontalAlignment="Right">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00A855F7" Offset="0"/>
                                <GradientStop Color="#A855F7" Offset="0.35"/>
                                <GradientStop Color="#FF3CAC" Offset="0.7"/>
                                <GradientStop Color="#00FF3CAC" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <StackPanel Orientation="Horizontal" Margin="22,26,0,30">
                        <Image Source="/Assets/logo.png" Width="40" Height="40">
                            <Image.Effect>
                                <DropShadowEffect Color="#A855F7" BlurRadius="22" ShadowDepth="0" Opacity="0.9"/>
                            </Image.Effect>
                        </Image>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="INFO" FontFamily="{StaticResource NumFont}" FontSize="19" FontWeight="Bold" Foreground="White" Effect="{StaticResource GlowPurple}"/>
                            <TextBlock Text="HARDWARE" FontFamily="{StaticResource NumFont}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PinkBrush}" Margin="0,-3,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="Painel" x:Name="NavDashboard" IsChecked="True" Checked="Nav_Checked"/>
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE950;" Content="Hardware" x:Name="NavHardware" Checked="Nav_Checked"/>
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE9D9;" Content="Sensores" x:Name="NavSensors" Checked="Nav_Checked"/>
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE9D2;" Content="Desempenho" x:Name="NavPerformance" Checked="Nav_Checked"/>
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE7FC;" Content="Overlay de jogo" x:Name="NavOverlay" Checked="Nav_Checked"/>
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE713;" Content="Configurações" x:Name="NavSettings" Checked="Nav_Checked"/>
                    </StackPanel>

                    <Border Grid.Row="2" Margin="14,0,14,18" Padding="14,12" CornerRadius="12" Background="#130A24" BorderBrush="#2A1A4A" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource GreenBrush}" Effect="{StaticResource GlowCyan}" Margin="0,0,8,0"/>
                                <TextBlock Text="Monitorando" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="{Binding HardwareStatus}" Style="{StaticResource Mute}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock x:Name="RecordingHint" Text="● Gravando sessão" Foreground="{StaticResource RedBrush}" FontSize="11.5" FontWeight="SemiBold"
                                       Margin="0,6,0,0" Visibility="{Binding Recorder.IsRecording, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ===== Conteúdo ===== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="32,0,0,0">
                        <TextBlock x:Name="PageTitle" Text="Painel" FontSize="13" Foreground="{StaticResource TextDimBrush}"/>
                        <TextBlock Text="  ·  " Foreground="{StaticResource TextMuteBrush}" FontSize="13"/>
                        <TextBlock Text="{Binding Summary.Computer}" Foreground="{StaticResource TextMuteBrush}" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" Click="Minimize_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimizar"/>
                        <Button Style="{StaticResource TitleBarButton}" x:Name="MaxButton" Content="&#xE922;" Click="Maximize_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximizar"/>
                        <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Fechar"/>
                    </StackPanel>
                </Grid>

                <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False"/>
            </Grid>
        </Grid>
    </Border>
</Window>
